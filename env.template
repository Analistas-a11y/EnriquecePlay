# Copie para .env e preencha. Nunca versione o .env.
PORT=9376
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
ADMIN_PASSWORD=
SAF_PASSWORD=
ESTRATEGIA_PASSWORD=

# Nova Vida
NOVA_VIDA_USER=
NOVA_VIDA_PASSWORD=
NOVA_VIDA_CLIENT=
NOVA_VIDA_BASE_URL=https://wsnv.novavidati.com.br

# Enriquecimento (padrao 80, teto 200)
ENRICHMENT_CONCURRENCY=100

# Estrategia OS (login unico em iframe e micro-API do Cockpit)
ESTRATEGIA_OS_URL=https://estrategiaos.bookplay.com.br
# origens que podem embutir o sistema e enviar AUTH_SESSION (separadas por virgula; o endereco antigo da Vercel pode ficar durante a transicao)
ESTRATEGIA_OS_ALLOWED_ORIGINS=https://estrategiaos.bookplay.com.br,https://estrategia-os.vercel.app
# opcional: endereco da chave publica, se diferente de <ESTRATEGIA_OS_URL>/api/auth/public-key.pem
OS_PUBLIC_KEY_URL=
# chave da micro-API: COPIE o valor que ja esta em uso (o Estrategia OS guarda o mesmo). Nao gerar outra.
INTEGRATION_API_KEY=

# Cookies (o sistema roda dentro de iframe: SameSite=None exige Secure)
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=1

# Quando o front esta na Coolify (nginx na frente do tunel): le o IP real do visitante deste cabecalho
CLIENT_IP_HEADER=X-Original-Client-IP

# Supabase (opcional; vazio = modo local em data/*.json)
SUPABASE_URL=
SUPABASE_KEY=
